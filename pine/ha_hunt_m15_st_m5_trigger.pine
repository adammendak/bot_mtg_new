//@version=6

// ─────────────────────────────────────────────────────────────────────────────
// HA-Hunt M15 / H1 ST + M5 trigger — RESEARCH overlay (does NOT replace
// ha_hunt_cloud.pine, ha_hunt_cloud_v2.pine, ha_hunt_m5_h1_supertrend.pine,
// or the M15/H1-ST draft).
//
// Chart: **M15**, NORMAL candles (HA is computed inside). HUD warns if TF ≠ 15.
// Java / prod HTS / HaHuntEngine / Heroku are unchanged.
//
// Why this exists
//   M5-only band + tight SL was a chop disaster (clusters of SLs). Waiting for
//   a slow **M15 band cross** is often too late — price has already run.
//   Sweet spot: HTF bias = closed **H1 Supertrend**; entry = **early M5**
//   band poke while H1 ST agrees, without waiting for the M15 ribbon cross.
//
//   HTF filter : last CLOSED H1 Supertrend direction
//                (ta.supertrend, request.security + [1], lookahead_off).
//                TV dir −1 = bull → longs only; +1 = bear → shorts only.
//                Shade / banners follow live H1 ST.
//   Optional   : also require closed H12 Supertrend or H12 HA (default OFF).
//   Entry      : input select. Default **M5 band poke / cross** — first CLOSED
//                M5 beyond the M5 fast RMA high/low band (v2 loose;
//                bandCrossStrict off). Must match H1 ST. Cap fills per H1 ST
//                regime (default 2).
//                M5 series come from request.security_lower_tf("5") so every
//                closed M5 inside the M15 bar can fire (not only the last M5).
//                Alternates: **M15 structure exit** (leaves recent M15 range
//                or first M15 HA+RMA stack with the trade) and **M15 band
//                cross** (late v2 reference, for A/B latency).
//   Anti-chop  : DEFAULT ON. When the trigger is M5, also require M15 already
//                WITH the trade (M15 HA colour OR M15 close vs RMA33 vs slow).
//                M5 is an early trigger *inside* M15 bias — not pure M5 noise.
//                Turn off only to A/B the gate; that path looks like the M5
//                chop tape.
//   Stop mode  : default **H1 ATR × 2.5** (safer with an M5 trigger than the
//                H1 ST line, which is often too wide/narrow vs M5). Alternates:
//                H1 Supertrend line, M15 fast-band far edge.
//   TP1+runner : default ON (Cloud v2). TP1 = entry ± 2 × |entry − SL|.
//                After TP1: ST mode trails the updating H1 ST line (ratchet);
//                ATR / band modes trail the M15 fast-band far edge.
//                Runner ends on a body close beyond the M15 slow band.
//                Optional flatten on closed H1 ST flip (default ON).
//
// Supertrend formula (classic TradingView `ta.supertrend(factor, atrPeriod)`):
//   src     = hl2 = (high + low) / 2
//   atr     = ta.atr(atrPeriod)          // Wilder RMA of True Range, NOT SMA
//   // Built-in direction:  -1 = up / bull (price above the line)
//   //                      +1 = down / bear (price below the line)
//   Defaults: ATR period 10, factor 2.0
// ─────────────────────────────────────────────────────────────────────────────
indicator("HA-Hunt M15 / H1 ST + M5 trigger", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// ── strategy ─────────────────────────────────────────────────────────────────
entryTrig  = input.string("M5 band poke / cross", "Entry trigger", options = [
     "M5 band poke / cross",
     "M15 structure exit",
     "M15 band cross"], tooltip = "Default = early M5 close beyond the M5 fast high/low RMA band (via lower-TF security), gated by closed H1 ST. M15 structure exit = price leaves the recent M15 range or first M15 HA+RMA stack with the trade. M15 band cross = late Cloud-v2 reference on this chart (A/B latency).", group = "Strategy")
bandCrossStrict = input.bool(false, "Band cross: require band-clear (engine)", tooltip = "Off (default, early): first closed bar with close > fast high (long) or close < fast low (short), even if fast/slow bands overlap. On: also require the entire fast band clear of slow. Applies to both the M5 trigger and the M15 band-cross option.", group = "Strategy")
reqM15With = input.bool(true,  "M5 trigger: require M15 with-trade (anti-chop)", tooltip = "ON (default) — the sensible gate. M5 may fire only when M15 is already WITH the trade: M15 HA colour OR M15 close stacked vs RMA33 vs slow. M5 is then an early trigger inside M15 bias, not a standalone M5 band system (that chopped with tight SLs). Off: M5 + H1 ST only, for A/B. Ignored when trigger is an M15 mode.", group = "Strategy")
h12Mode    = input.string("Off", "Optional H12 context", options = ["Off", "H12 Supertrend", "H12 HA"], tooltip = "Off (default). H12 Supertrend = also require closed H12 ST in trade direction (same ATR/factor as H1). H12 HA = also require last closed H12 Heikin-Ashi colour in trade direction.", group = "Strategy")
structLen  = input.int(8,      "M15 structure lookback (bars)", minval = 2, maxval = 48, tooltip = "Used by M15 structure exit: Donchian range of this many prior M15 bars. 8 bars = 2 hours.", group = "Strategy")
longOnly   = input.bool(false, "Long only (shorts = observe-only)", tooltip = "Off (default) so both BUY and SELL print when H1 ST agrees. On: shorts are observe-only.", group = "Strategy")
enableLong  = input.bool(true, "Enable LONG signals", group = "Strategy")
enableShort = input.bool(true, "Enable SHORT signals", group = "Strategy")
showShorts  = input.bool(true, "Show SELL setups (even in long-only)", group = "Strategy")
applyPP    = input.bool(false, "Daily pivot filter  (OFF for indices / crypto)", tooltip = "Previous completed 21:00-UTC session. Default off — turn on for FX if you want PP alignment.", group = "Strategy")
capReg     = input.int(2,      "Max entries per H1 Supertrend regime", minval = 1, tooltip = "Fills reset when closed H1 ST flips. 2 is the HA-Hunt default; try 1 if the M5 trigger is still busy.", group = "Strategy")
stopMode   = input.string("H1 ATR × 2.5", "Stop mode", options = ["H1 ATR × 2.5", "H1 Supertrend", "M15 fast-band far edge"], tooltip = "H1 ATR × 2.5 (default) = entry ∓ atrMult × closed H1 ATR14 — safer mismatch vs an M5 trigger than the H1 ST line. H1 Supertrend = SL at the closed H1 ST line. M15 fast-band far edge = chart-TF fast high/low RMA ± buffer.", group = "Strategy")
atrMult    = input.float(2.5,  "Stop = H1 ATR ×", step = 0.1, tooltip = "Used when Stop mode = H1 ATR × 2.5, and as fallback if H1 ST / M15 fast band cannot form a valid 1R.", group = "Strategy")
bandSlBuf  = input.float(0.25, "Band SL buffer × width", step = 0.05, minval = 0.0, tooltip = "M15 band SL and band-mode runner trail offset = this × (fast high − fast low). Long edge = fLo − buf, short = fUp + buf.", group = "Strategy")
useTp1     = input.bool(true,  "Enable TP1 + runner", tooltip = "On (default): TP1 at entry ± R×, then trail (H1 ST line in ST stop mode, M15 fast-band far edge otherwise); full exit when the body closes beyond the M15 slow band.", group = "Strategy")
tp1Mult    = input.float(2.0,  "TP1 = R ×", step = 0.5, minval = 0.5, tooltip = "TP1 distance = this × |entry − stop|. 2.0 = 1:2 from the chosen stop.", group = "Strategy")
exitStFlip = input.bool(true,  "Also exit on H1 Supertrend flip", tooltip = "On (default): flatten when closed H1 ST flips against the position (the HTF filter is gone). Off: runner may continue until slow-band body close / SL.", group = "Strategy")
fastLen    = input.int(33,     "RMA fast  (engine RMA_FAST = 33)", group = "Strategy")
slowLen    = input.int(100,    "RMA slow  (HA4 default 100)", group = "Strategy")

// ── H1 Supertrend (classic TV) ───────────────────────────────────────────────
stAtrLen = input.int(10,    "H1 Supertrend ATR period", minval = 1, group = "H1 Supertrend")
stFactor = input.float(2.0, "H1 Supertrend factor", step = 0.1, minval = 0.1, group = "H1 Supertrend")
stTf     = input.timeframe("60", "HTF (H1)", group = "H1 Supertrend", tooltip = "Closed-bar Supertrend via request.security, lookahead_off. Keep 60 for the documented H1 filter.")
h12Tf    = input.timeframe("720", "Optional H12 timeframe", group = "H1 Supertrend", tooltip = "Used only when Optional H12 context is not Off. 720 = 12 hours.")

// ── visuals ──────────────────────────────────────────────────────────────────
shadeReg    = input.bool(true,  "Shade H1 Supertrend direction", group = "Visuals")
bgLongCol   = input.color(color.new(#26A69A, 94), "Background — H1 ST bull", group = "Visuals")
bgShortCol  = input.color(color.new(#EF5350, 94), "Background — H1 ST bear", group = "Visuals")
showBoxes   = input.bool(true,  "Risk / reward boxes", group = "Visuals")
showEdge    = input.bool(true,  "SL / Entry / TP1 edge lines", group = "Visuals")
showTags    = input.bool(true,  "Price tags on box edge", group = "Visuals")
showBadge   = input.bool(true,  "Entry / exit badges", group = "Visuals")
showAllSig  = input.bool(true,  "Label every gated signal", tooltip = "On (default): ▲ BUY / ▼ SELL on every trigger that passes H1 ST (and gates), not only the taken fills. Taken trades still get the risk box.", group = "Visuals")
showHistory = input.bool(false, "Show history (past entry / SL / TP1)", group = "Visuals")
showHud     = input.bool(true,  "Corner HUD", group = "Visuals")
hudPosIn    = input.string("Bottom left", "HUD position", options = ["Top left", "Top right", "Bottom left", "Bottom right", "Middle left", "Middle right"], tooltip = "One table only. Default bottom-left so it does not sit on TV buy/sell.", group = "Visuals")
showBands   = input.bool(true,  "Plot M15 fast / slow high-low RMA bands", tooltip = "Chart-TF (M15) ribbons — M15 band-cross / structure / runner use these.", group = "Visuals")
showM5Bands = input.bool(true,  "Plot M5 fast RMA band (closed)", tooltip = "Last closed M5 fast high/low RMA — the early-trigger band. Stepline (not the M15 ribbons).", group = "Visuals")
showDbg     = input.bool(false, "Debug last-bar gates", tooltip = "When on, appends gate rows to the bottom HUD. No second table.", group = "Visuals")
showStFlipL = input.bool(true, "H1 ST flip triangle — bull", group = "Visuals")
showStFlipS = input.bool(true, "H1 ST flip triangle — bear", group = "Visuals")
triOffAtr   = input.float(2.5, "BULL/BEAR triangle offset × ATR", step = 0.25, minval = 0.5, group = "Visuals")
boxExtend   = input.int(24,    "Box length (bars)", minval = 8, maxval = 100, group = "Visuals")
boxTransR   = input.int(82,    "Risk box transparency", minval = 50, maxval = 95, group = "Visuals")
boxTransW   = input.int(85,    "Reward box transparency", minval = 50, maxval = 95, group = "Visuals")

colBuy     = input.color(#26A69A, "Buy / reward", group = "Colors")
colSell    = input.color(#EF5350, "Sell / risk", group = "Colors")
colEntry   = input.color(#42A5F5, "Entry line", group = "Colors")
colExit    = input.color(#FFB74D, "HTF ST / slow-band exit", group = "Colors")
colHuntL   = input.color(#26A69A, "H1 ST bull banner", group = "Colors")
colHuntS   = input.color(#EF5350, "H1 ST bear banner", group = "Colors")
colM5      = input.color(#90CAF9, "M5 fast band", group = "Colors")

useM5      = entryTrig == "M5 band poke / cross"
useStruct  = entryTrig == "M15 structure exit"
useM15Band = entryTrig == "M15 band cross"
useStSl    = stopMode == "H1 Supertrend"
useBandSl  = stopMode == "M15 fast-band far edge"
useH12St   = h12Mode == "H12 Supertrend"
useH12Ha   = h12Mode == "H12 HA"
wantTfLbl  = "M15"
chartOk    = timeframe.period == "15" or timeframe.in_seconds() == 15 * 60
chartIsM5  = timeframe.period == "5" or timeframe.in_seconds() == 5 * 60

// ── M15 Heikin-Ashi (this chart) ─────────────────────────────────────────────
haClose = (open + high + low + close) / 4.0
var float haOpen = na
haOpen := na(haOpen[1]) ? (open + close) / 2.0 : (haOpen[1] + haClose[1]) / 2.0
eBull  = haClose >= haOpen
eFlip  = eBull != eBull[1]  // M15 HA cloud colour change (structure option)

// ── M15 RMA stack + high/low bands (chart TF) ────────────────────────────────
rf = ta.rma(close, fastLen)
rs = ta.rma(close, slowLen)
stackLong  = close > rf and rf > rs
stackShort = close < rf and rf < rs
atr14      = ta.atr(14)

rfHi = ta.rma(high, fastLen), rfLo = ta.rma(low, fastLen)
rsHi = ta.rma(high, slowLen), rsLo = ta.rma(low, slowLen)
fUp = math.max(rfHi, rfLo), fLo = math.min(rfHi, rfLo)
sUp = math.max(rsHi, rsLo), sLo = math.min(rsHi, rsLo)
beyondLong  = close > fUp
beyondShort = close < fLo
clearLong   = fLo > sUp
clearShort  = fUp < sLo
longNow  = beyondLong  and (not bandCrossStrict or clearLong)
shortNow = beyondShort and (not bandCrossStrict or clearShort)
crossLong  = longNow  and not longNow[1]
crossShort = shortNow and not shortNow[1]
rawPokeLong  = beyondLong  and not beyondLong[1]
rawPokeShort = beyondShort and not beyondShort[1]

pFup = plot(showBands ? fUp : na, "M15 Fast RMA high", color = color.new(colBuy, 20), linewidth = 1, display = display.pane)
pFlo = plot(showBands ? fLo : na, "M15 Fast RMA low",  color = color.new(colBuy, 20), linewidth = 1, display = display.pane)
pSup = plot(showBands ? sUp : na, "M15 Slow RMA high", color = color.new(colExit, 40), linewidth = 1, display = display.pane)
pSlo = plot(showBands ? sLo : na, "M15 Slow RMA low",  color = color.new(colExit, 40), linewidth = 1, display = display.pane)
fill(pFlo, pFup, color = color.new(colBuy, 90), title = "M15 Fast band")
fill(pSlo, pSup, color = color.new(colExit, 92), title = "M15 Slow band")
plotshape(useM15Band and rawPokeLong,  "Raw M15 band poke LONG",  shape.circle, location.belowbar, color.new(#78909C, 35), size = size.tiny)
plotshape(useM15Band and rawPokeShort, "Raw M15 band poke SHORT", shape.circle, location.abovebar, color.new(#78909C, 35), size = size.tiny)

// Anti-chop WITH: M15 already on the trade side (HA colour OR RMA stack).
m15WithLong  = eBull or stackLong
m15WithShort = (not eBull) or stackShort

// ── M15 structure exit (range leave or first HA+stack with the trade) ────────
rngHi = ta.highest(high, structLen)[1]
rngLo = ta.lowest(low, structLen)[1]
leaveLong  = not na(rngHi) and close > rngHi
leaveShort = not na(rngLo) and close < rngLo
structRangeL = leaveLong  and not leaveLong[1]
structRangeS = leaveShort and not leaveShort[1]
m15BiasOnL = eBull and stackLong
m15BiasOnS = (not eBull) and stackShort
structStackL = m15BiasOnL and not m15BiasOnL[1]
structStackS = m15BiasOnS and not m15BiasOnS[1]
structHaL = eFlip and eBull
structHaS = eFlip and not eBull
structLong  = structRangeL or structStackL or structHaL
structShort = structRangeS or structStackS or structHaS

// ── M5 band poke — closed M5 via lower-TF security ───────────────────────────
// Evaluated on M5: first confirmed close beyond the M5 fast high/low RMA band.
// Returns 1 = long cross, −1 = short cross, 0 = none. Forming M5 → 0.
f_m5CrossCode() =>
    float mRfHi = ta.rma(high, fastLen)
    float mRfLo = ta.rma(low, fastLen)
    float mRsHi = ta.rma(high, slowLen)
    float mRsLo = ta.rma(low, slowLen)
    float mFUp = math.max(mRfHi, mRfLo)
    float mFLo = math.min(mRfHi, mRfLo)
    float mSUp = math.max(mRsHi, mRsLo)
    float mSLo = math.min(mRsHi, mRsLo)
    bool mLn = (close > mFUp) and (not bandCrossStrict or mFLo > mSUp)
    bool mSn = (close < mFLo) and (not bandCrossStrict or mFUp < mSLo)
    bool mXl = mLn and not mLn[1]
    bool mXs = mSn and not mSn[1]
    barstate.isconfirmed ? (mXl ? 1.0 : mXs ? -1.0 : 0.0) : 0.0

f_m5FastClosed() =>
    float mRfHi = ta.rma(high, fastLen)
    float mRfLo = ta.rma(low, fastLen)
    [math.max(mRfHi, mRfLo)[1], math.min(mRfHi, mRfLo)[1]]

m5CodeArr = request.security_lower_tf(syminfo.tickerid, "5", f_m5CrossCode(), ignore_invalid_timeframe = true)
m5TimeArr = request.security_lower_tf(syminfo.tickerid, "5", time, ignore_invalid_timeframe = true)
m5ConfArr = request.security_lower_tf(syminfo.tickerid, "5", barstate.isconfirmed ? 1.0 : 0.0, ignore_invalid_timeframe = true)
[m5FUp, m5FLo] = request.security(syminfo.tickerid, "5", f_m5FastClosed(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

plot(showM5Bands ? m5FUp : na, "M5 Fast RMA high (closed)", color = color.new(colM5, 10), linewidth = 1, style = plot.style_stepline)
plot(showM5Bands ? m5FLo : na, "M5 Fast RMA low (closed)",  color = color.new(colM5, 10), linewidth = 1, style = plot.style_stepline)

// Consume each closed M5 once so a forming M15 bar does not re-fire the same poke.
var int lastM5Consumed = 0
bool trigM5Long = false
bool trigM5Short = false
int nM5 = na(m5CodeArr) ? 0 : array.size(m5CodeArr)
int nT  = na(m5TimeArr) ? 0 : array.size(m5TimeArr)
int nC  = na(m5ConfArr) ? 0 : array.size(m5ConfArr)
int nScan = math.min(math.min(nM5, nT), nC)
int maxT = lastM5Consumed
if nScan > 0
    for i = 0 to nScan - 1
        float tF = array.get(m5TimeArr, i)
        float cF = array.get(m5CodeArr, i)
        float confF = array.get(m5ConfArr, i)
        int t = int(tF)
        // Skip the forming M5 (last LTF bar) so its timestamp is not consumed
        // before the close; otherwise a later confirmed poke on that same bar
        // would be ignored.
        if confF > 0.5 and t > lastM5Consumed
            if cF > 0.5
                trigM5Long := true
            if cF < -0.5
                trigM5Short := true
            if t > maxT
                maxT := t
lastM5Consumed := maxT

// If the chart itself is M5 (wrong TF), fall back to local band cross so the
// script still compiles / draws; HUD will still warn to use M15.
if chartIsM5
    trigM5Long := crossLong
    trigM5Short := crossShort

plotshape(useM5 and trigM5Long,  "M5 band poke LONG",  shape.circle, location.belowbar, color.new(colM5, 15), size = size.tiny)
plotshape(useM5 and trigM5Short, "M5 band poke SHORT", shape.circle, location.abovebar, color.new(colM5, 15), size = size.tiny)

// ── H1 Supertrend — classic TV ta.supertrend (Wilder ATR, hl2, factor) ───────
// Live (repainting forming H1) — shading + flip triangles only.
f_st() =>
    [stLine, stDir] = ta.supertrend(stFactor, stAtrLen)
    [stLine, stDir]

[stLineLive, stDirLive] = request.security(syminfo.tickerid, stTf, f_st(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

// Confirmed CLOSED H1 — filter / SL / regime cap / optional flip exit.
f_stClosed() =>
    [stLine, stDir] = ta.supertrend(stFactor, stAtrLen)
    [stLine[1], stDir[1]]

[stLine, stDir] = request.security(syminfo.tickerid, stTf, f_stClosed(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

// ta.supertrend dir: -1 = bull (price above line), +1 = bear.
stBull     = not na(stDir) and stDir == -1
stBear     = not na(stDir) and stDir == 1
stBullLive = not na(stDirLive) and stDirLive == -1
stFlip     = stBull != stBull[1]
stFlipLive = stBullLive != stBullLive[1]

plot(stLine, "H1 Supertrend (closed)", color = color.new(stBull ? colBuy : colSell, 20), linewidth = 2, style = plot.style_stepline, display = display.pane)

// Closed H1 ATR14 — default stop distance (not the ST ATR-10).
h1Atr = request.security(syminfo.tickerid, stTf, ta.atr(14)[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

// ── optional closed H12 Supertrend / H12 HA ──────────────────────────────────
[h12Line, h12Dir] = request.security(syminfo.tickerid, h12Tf, f_stClosed(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
h12StBull = not na(h12Dir) and h12Dir == -1
h12StBear = not na(h12Dir) and h12Dir == 1
haT = ticker.heikinashi(syminfo.tickerid)
h12HaBull = request.security(haT, h12Tf, close[1] >= open[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
h12LongOk  = (not useH12St and not useH12Ha) or (useH12St and h12StBull) or (useH12Ha and h12HaBull)
h12ShortOk = (not useH12St and not useH12Ha) or (useH12St and h12StBear) or (useH12Ha and not h12HaBull)

bw = fUp - fLo

// Initial SL. ATR mode (default): closed H1 ATR14 × atrMult.
// ST mode: closed H1 Supertrend line on the protective side of entry.
// Band mode: M15 fast far-edge ± buffer. Else / fallback: H1 ATR.
stopPrice(isLong) =>
    float atrR = atrMult * h1Atr
    float atrSl = isLong ? close - atrR : close + atrR
    bool stOk = useStSl and not na(stLine) and (isLong ? stLine < close : stLine > close)
    bool bandOk = useBandSl and not na(fUp) and not na(fLo) and not na(bw) and bw > 0
    float rawB = isLong ? fLo - bandSlBuf * bw : fUp + bandSlBuf * bw
    float distB = math.abs(close - rawB)
    bool useB = bandOk and not na(distB) and distB > 0
    stOk ? stLine : (useB ? rawB : atrSl)

// After TP1: ST mode ratchets along the closed H1 ST line; otherwise M15
// fast-band far edge (fLo/−buf, fUp/+buf). Never widen — caller ratchets.
trailStop(isLong) =>
    float width = fUp - fLo
    bool bandOk = not na(fUp) and not na(fLo) and not na(width) and width > 0
    float buf = bandSlBuf * nz(width, 0.0)
    float bandTr = bandOk ? (isLong ? fLo - buf : fUp + buf) : na
    useStSl ? stLine : bandTr

// ── daily pivot — previous completed 21:00-UTC session ──────────────────────
sIdx = math.floor((time / 1000 - 75600) / 86400)   // 75600s = 21:00 UTC roll
newS = ta.change(sIdx) != 0
var float cH = na, var float cL = na, var float cC = na
var float pH = na, var float pL = na, var float pC = na
if newS
    pH := cH, pL := cL, pC := cC
    cH := high, cL := low, cC := close
else
    cH := math.max(nz(cH, high), high)
    cL := math.min(nz(cL, low), low)
    cC := close
pp      = (pH + pL + pC) / 3.0
ppLong  = not applyPP or (not na(pp) and close > pp)
ppShort = not applyPP or (not na(pp) and close < pp)

// ── state ───────────────────────────────────────────────────────────────────
var int   fills   = 0
var int   pos     = 0
var float entPx   = na
var float stpX    = na
var float tgtX    = na
var bool  tp1Hit  = false
var float lastR   = na
var box   bxRisk  = na
var box   bxRew   = na
var line  lnStop  = na
var line  lnEntry = na
var line  lnTgt   = na
var label lbStop  = na
var label lbEntry = na
var label lbTgt   = na
var table hud     = na

if stFlip
    fills := 0

// ── H1 ST flip banners (live forming H1 — same series as the shade) ──────────
triOff = triOffAtr * atr14
plotshape(stFlipLive and stBullLive and showStFlipL ? low - triOff : na, "BULL H1 ST", shape.triangleup, location.absolute, colHuntL, size = size.normal)
plotshape(stFlipLive and not stBullLive and showStFlipS ? high + triOff : na, "BEAR H1 ST", shape.triangledown, location.absolute, colHuntS, size = size.normal)

// ── exits: SL/trail wick, TP1→runner, M15 slow-band body close, optional ST flip
exitStop = pos != 0 and ((pos == 1 and low <= stpX) or (pos == -1 and high >= stpX))
exitSlow = useTp1 and tp1Hit and barstate.isconfirmed and ((pos == 1 and close < sLo) or (pos == -1 and close > sUp))
exitFlip = exitStFlip and pos != 0 and ((pos == 1 and not stBull) or (pos == -1 and stBull))
doExit   = pos != 0 and (exitStop or exitSlow or exitFlip)
exitRsn  = exitStop ? "stop" : exitSlow ? "slow_band" : "h1_st_flip"
tp1Touch = useTp1 and pos != 0 and not tp1Hit and not doExit and ((pos == 1 and high >= tgtX) or (pos == -1 and low <= tgtX))
if tp1Touch
    tp1Hit := true
    if showBadge
        label.new(bar_index, pos == 1 ? high : low, "TP1\n" + str.tostring(tgtX, format.mintick), yloc = pos == 1 ? yloc.abovebar : yloc.belowbar, style = pos == 1 ? label.style_label_down : label.style_label_up, color = color.new(colBuy, 0), textcolor = color.white, size = size.small)

// After TP1: ratchet trail (ST line or M15 fast-band far edge). Never widen.
if useTp1 and tp1Hit and pos != 0 and not doExit
    float tr = trailStop(pos == 1)
    if not na(tr)
        if pos == 1 and tr > stpX
            stpX := tr
        if pos == -1 and tr < stpX
            stpX := tr
        if showEdge and not na(lnStop)
            line.set_y1(lnStop, stpX), line.set_y2(lnStop, stpX)
        if showTags and not na(lbStop)
            label.set_y(lbStop, stpX)
            label.set_text(lbStop, "TRL  " + str.tostring(stpX, format.mintick))
        if showBoxes and not na(bxRisk)
            box.set_top(bxRisk, math.max(entPx, stpX)), box.set_bottom(bxRisk, math.min(entPx, stpX))

if doExit
    if showBadge
        string xt = exitStop ? "✕  SL" : exitSlow ? "✕  slow band" : "ST  H1 flip"
        color  xc = exitStop ? colSell : colExit
        label.new(bar_index, pos == 1 ? high : low, xt + "\n" + str.tostring(close, format.mintick), yloc = pos == 1 ? yloc.abovebar : yloc.belowbar, style = pos == 1 ? label.style_label_down : label.style_label_up, color = color.new(xc, 5), textcolor = color.white, size = size.small)
    if showHistory
        if not na(bxRisk)
            box.set_right(bxRisk, bar_index), box.set_right(bxRew, bar_index)
        if not na(lnStop)
            line.set_x2(lnStop, bar_index), line.set_x2(lnEntry, bar_index), line.set_x2(lnTgt, bar_index)
        if not na(lbStop)
            label.set_x(lbStop, bar_index), label.set_x(lbEntry, bar_index), label.set_x(lbTgt, bar_index)
    else
        box.delete(bxRisk), box.delete(bxRew)
        line.delete(lnStop), line.delete(lnEntry), line.delete(lnTgt)
        label.delete(lbStop), label.delete(lbEntry), label.delete(lbTgt)
    bxRisk := na, bxRew := na, lnStop := na, lnEntry := na, lnTgt := na
    lbStop := na, lbEntry := na, lbTgt := na
    pos := 0
    tp1Hit := false

// ── entry ───────────────────────────────────────────────────────────────────
canEnter = fills < capReg and pos == 0
trigLong  = useM5 ? trigM5Long : useStruct ? structLong : crossLong
trigShort = useM5 ? trigM5Short : useStruct ? structShort : crossShort
m15GateL = (not useM5 or not reqM15With) or m15WithLong
m15GateS = (not useM5 or not reqM15With) or m15WithShort
longRaw  = stBull and trigLong  and m15GateL and h12LongOk  and ppLong
shortRaw = stBear and trigShort and m15GateS and h12ShortOk and ppShort
longSig  = longRaw and canEnter and enableLong
shortSig = shortRaw and canEnter and enableShort and not longOnly

if longSig or shortSig
    if showHistory
        if not na(bxRisk)
            box.set_right(bxRisk, bar_index), box.set_right(bxRew, bar_index)
        if not na(lnStop)
            line.set_x2(lnStop, bar_index), line.set_x2(lnEntry, bar_index), line.set_x2(lnTgt, bar_index)
    else
        box.delete(bxRisk), box.delete(bxRew)
        line.delete(lnStop), line.delete(lnEntry), line.delete(lnTgt)
        label.delete(lbStop), label.delete(lbEntry), label.delete(lbTgt)
    bxRisk := na, bxRew := na, lnStop := na, lnEntry := na, lnTgt := na
    lbStop := na, lbEntry := na, lbTgt := na

    bool isLong = longSig
    pos    := isLong ? 1 : -1
    entPx  := close
    stpX   := stopPrice(isLong)
    lastR  := math.abs(close - stpX)
    tgtX   := isLong ? close + tp1Mult * lastR : close - tp1Mult * lastR
    tp1Hit := false
    fills  := fills + 1
    int x2 = bar_index + boxExtend
    if showBoxes
        bxRisk := box.new(bar_index, math.max(entPx, stpX), x2, math.min(entPx, stpX), bgcolor = color.new(colSell, boxTransR), border_color = color.new(colSell, 35), border_width = 2)
        bxRew  := box.new(bar_index, math.max(entPx, tgtX), x2, math.min(entPx, tgtX), bgcolor = color.new(colBuy, boxTransW), border_color = color.new(colBuy, 35), border_width = 2)
    if showEdge
        lnStop  := line.new(bar_index, stpX, x2, stpX, color = colSell, width = 2)
        lnEntry := line.new(bar_index, entPx, x2, entPx, color = colEntry, width = 1, style = line.style_dotted)
        lnTgt   := line.new(bar_index, tgtX, x2, tgtX, color = colBuy, width = 1, style = line.style_dashed)
    if showTags
        lbStop  := label.new(x2, stpX, "SL  " + str.tostring(stpX, format.mintick), style = label.style_label_left, color = color.new(colSell, 0), textcolor = color.white, size = size.small)
        lbEntry := label.new(x2, entPx, "IN  " + str.tostring(entPx, format.mintick), style = label.style_label_left, color = color.new(colEntry, 10), textcolor = color.white, size = size.tiny)
        lbTgt   := label.new(x2, tgtX, "TP1  " + str.tostring(tgtX, format.mintick), style = label.style_label_left, color = color.new(colBuy, 0), textcolor = color.white, size = size.tiny)
    if showBadge
        if isLong
            label.new(bar_index, low, "▲ BUY", yloc = yloc.belowbar, style = label.style_label_up, color = color.new(colBuy, 0), textcolor = color.white, size = size.small)
        else
            label.new(bar_index, high, "▼ SELL", yloc = yloc.abovebar, style = label.style_label_down, color = color.new(colSell, 0), textcolor = color.white, size = size.small)

if pos != 0
    int x2e = bar_index + boxExtend
    if showBoxes and not na(bxRisk)
        box.set_right(bxRisk, x2e), box.set_right(bxRew, x2e)
    if showEdge and not na(lnStop)
        line.set_x2(lnStop, x2e), line.set_x2(lnEntry, x2e), line.set_x2(lnTgt, x2e)
    if showTags and not na(lbStop)
        label.set_x(lbStop, x2e), label.set_x(lbEntry, x2e), label.set_x(lbTgt, x2e)

// ── HUD (one table; debug rows append when showDbg) ──────────────────────────
hudPos = switch hudPosIn
    "Top left" => position.top_left
    "Top right" => position.top_right
    "Bottom right" => position.bottom_right
    "Middle left" => position.middle_left
    "Middle right" => position.middle_right
    => position.bottom_left

hudBg = #1E222D
hudLb = #B2B5BE
hudRows = showDbg ? 24 : 16
var string hudPosUsed = na
var int    hudRowsUsed = na
if barstate.islast and showHud
    if na(hud) or hudPosUsed != hudPosIn or hudRowsUsed != hudRows
        if not na(hud)
            table.delete(hud)
        hud := table.new(hudPos, 2, hudRows, bgcolor = hudBg, border_width = 1, border_color = #787B86, frame_width = 2, frame_color = #B2B5BE)
        hudPosUsed := hudPosIn
        hudRowsUsed := hudRows
    string sideTxt = pos == 0 ? "FLAT" : pos == 1 ? "LONG" : "SHORT"
    color  sideC   = pos == 0 ? #B2B5BE : pos == 1 ? colBuy : colSell
    string trigTxt = useM5 ? (bandCrossStrict ? "M5 band (strict)" : "M5 band (loose)") : useStruct ? "M15 structure" : (bandCrossStrict ? "M15 band (strict)" : "M15 band (loose)")
    string chartTxt = wantTfLbl + " / chart " + timeframe.period + (chartOk ? "" : "  ⚠ use M15")
    string runTxt = pos == 0 ? "—" : not useTp1 ? "off" : tp1Hit ? (useStSl ? "runner (H1 ST)" : "runner (M15 band)") : "open → TP1"
    string exitTxt = (useTp1 ? "TP1 + runner" : "SL") + (exitStFlip ? " + H1 ST flip" : "")
    string stopModeTxt = useStSl ? "H1 Supertrend" : useBandSl ? "M15 fast-band" : "H1 ATR × " + str.tostring(atrMult)
    string stTxt = na(stDirLive) ? "—" : stBullLive ? "BULL" : "BEAR"
    color  stCol = na(stDirLive) ? #B2B5BE : stBullLive ? colBuy : colSell
    string stPx  = na(stLine) ? "" : "  " + str.tostring(stLine, format.mintick)
    string h12Txt = not useH12St and not useH12Ha ? "off" : useH12St ? ((h12StBull ? "ST BULL" : h12StBear ? "ST BEAR" : "ST —") + (na(h12Line) ? "" : "  " + str.tostring(h12Line, format.mintick))) : (h12HaBull ? "HA BULL" : "HA BEAR")
    color  h12Col = not useH12St and not useH12Ha ? hudLb : (useH12St ? (h12StBull ? colBuy : colSell) : (h12HaBull ? colBuy : colSell))
    bool withGate = stBull ? m15GateL : m15GateS
    bool ppGate   = stBull ? ppLong : ppShort
    bool h12Gate  = stBull ? h12LongOk : h12ShortOk
    string m15GateTxt = not useM5 ? "M15 n/a" : not reqM15With ? "M15-with off" : (withGate ? "M15-with✓" : "M15-with✗")
    string gateTxt = (stBull ? "ST↑" : stBear ? "ST↓" : "ST—") + "  " + m15GateTxt + (useH12St or useH12Ha ? (h12Gate ? "  H12✓" : "  H12✗") : "  H12 off") + (applyPP ? (ppGate ? "  PP✓" : "  PP✗") : "  PP off") + (canEnter ? "  in✓" : "  in✗")
    table.cell(hud, 0, 0, "HA-Hunt M15", bgcolor = hudBg, text_color = color.white, text_size = size.normal)
    table.cell(hud, 1, 0, "H1 ST + M5 trig", bgcolor = hudBg, text_color = color.white, text_size = size.normal)
    table.cell(hud, 0, 1, "Side", bgcolor = hudBg, text_color = hudLb, text_size = size.small)
    table.cell(hud, 1, 1, sideTxt + (tp1Hit ? "  runner" : "") + (longOnly and pos == 0 ? "  (L-only)" : ""), bgcolor = hudBg, text_color = sideC, text_size = size.small)
    table.cell(hud, 0, 2, "Trigger", bgcolor = hudBg, text_color = hudLb, text_size = size.small)
    table.cell(hud, 1, 2, trigTxt, bgcolor = hudBg, text_color = color.white, text_size = size.small)
    table.cell(hud, 0, 3, "Chart TF", bgcolor = hudBg, text_color = hudLb, text_size = size.small)
    table.cell(hud, 1, 3, chartTxt, bgcolor = hudBg, text_color = chartOk ? color.white : colExit, text_size = size.small)
    table.cell(hud, 0, 4, "H1 ST", bgcolor = hudBg, text_color = hudLb, text_size = size.small)
    table.cell(hud, 1, 4, stTxt + stPx, bgcolor = hudBg, text_color = stCol, text_size = size.small)
    table.cell(hud, 0, 5, "H12", bgcolor = hudBg, text_color = hudLb, text_size = size.small)
    table.cell(hud, 1, 5, h12Txt, bgcolor = hudBg, text_color = h12Col, text_size = size.small)
    table.cell(hud, 0, 6, "Stop mode", bgcolor = hudBg, text_color = hudLb, text_size = size.small)
    table.cell(hud, 1, 6, stopModeTxt, bgcolor = hudBg, text_color = color.white, text_size = size.small)
    table.cell(hud, 0, 7, "Entry", bgcolor = hudBg, text_color = hudLb, text_size = size.small)
    table.cell(hud, 1, 7, pos != 0 ? str.tostring(entPx, format.mintick) : "—", bgcolor = hudBg, text_color = color.white, text_size = size.small)
    table.cell(hud, 0, 8, "Stop", bgcolor = hudBg, text_color = hudLb, text_size = size.small)
    table.cell(hud, 1, 8, pos != 0 ? str.tostring(stpX, format.mintick) : "—", bgcolor = hudBg, text_color = colSell, text_size = size.small)
    table.cell(hud, 0, 9, "TP1", bgcolor = hudBg, text_color = hudLb, text_size = size.small)
    table.cell(hud, 1, 9, pos != 0 ? ((tp1Hit ? "HIT  " : "") + str.tostring(tgtX, format.mintick)) : "—", bgcolor = hudBg, text_color = colBuy, text_size = size.small)
    table.cell(hud, 0, 10, useStSl ? "1R (H1 ST)" : useBandSl ? "1R (M15 band)" : "1R (" + str.tostring(atrMult) + "×H1 ATR)", bgcolor = hudBg, text_color = hudLb, text_size = size.small)
    table.cell(hud, 1, 10, pos != 0 ? str.tostring(lastR, format.mintick) : "—", bgcolor = hudBg, text_color = color.white, text_size = size.small)
    table.cell(hud, 0, 11, "Runner", bgcolor = hudBg, text_color = hudLb, text_size = size.small)
    table.cell(hud, 1, 11, runTxt, bgcolor = hudBg, text_color = tp1Hit ? colBuy : color.white, text_size = size.small)
    table.cell(hud, 0, 12, "Fills / regime", bgcolor = hudBg, text_color = hudLb, text_size = size.small)
    table.cell(hud, 1, 12, str.tostring(fills) + " / " + str.tostring(capReg), bgcolor = hudBg, text_color = color.white, text_size = size.small)
    table.cell(hud, 0, 13, "Gates", bgcolor = hudBg, text_color = hudLb, text_size = size.small)
    table.cell(hud, 1, 13, gateTxt, bgcolor = hudBg, text_color = (stBull or stBear) and withGate and h12Gate and ppGate ? color.white : colExit, text_size = size.small)
    table.cell(hud, 0, 14, "Anti-chop", bgcolor = hudBg, text_color = hudLb, text_size = size.small)
    table.cell(hud, 1, 14, m15GateTxt, bgcolor = hudBg, text_color = useM5 and reqM15With ? (withGate ? colBuy : colSell) : hudLb, text_size = size.small)
    table.cell(hud, 0, 15, "Exit", bgcolor = hudBg, text_color = hudLb, text_size = size.small)
    table.cell(hud, 1, 15, exitTxt, bgcolor = hudBg, text_color = colExit, text_size = size.small)
    if showDbg
        table.cell(hud, 0, 16, "trigLong", bgcolor = hudBg, text_color = hudLb, text_size = size.small)
        table.cell(hud, 1, 16, trigLong ? "yes" : "no", bgcolor = hudBg, text_color = trigLong ? colBuy : colSell, text_size = size.small)
        table.cell(hud, 0, 17, "trigShort", bgcolor = hudBg, text_color = hudLb, text_size = size.small)
        table.cell(hud, 1, 17, trigShort ? "yes" : "no", bgcolor = hudBg, text_color = trigShort ? colBuy : colSell, text_size = size.small)
        table.cell(hud, 0, 18, "M5 poke L/S", bgcolor = hudBg, text_color = hudLb, text_size = size.small)
        table.cell(hud, 1, 18, (trigM5Long ? "L" : "-") + " / " + (trigM5Short ? "S" : "-") + "  n=" + str.tostring(nScan), bgcolor = hudBg, text_color = (trigM5Long or trigM5Short) ? colBuy : hudLb, text_size = size.small)
        table.cell(hud, 0, 19, "M15 with", bgcolor = hudBg, text_color = hudLb, text_size = size.small)
        table.cell(hud, 1, 19, "L " + (m15WithLong ? "yes" : "no") + "  S " + (m15WithShort ? "yes" : "no"), bgcolor = hudBg, text_color = (stBull ? m15WithLong : m15WithShort) ? colBuy : colSell, text_size = size.small)
        table.cell(hud, 0, 20, "H1 ST closed", bgcolor = hudBg, text_color = hudLb, text_size = size.small)
        table.cell(hud, 1, 20, stBull ? "yes (bull)" : stBear ? "no (bear)" : "na", bgcolor = hudBg, text_color = stBull ? colBuy : colSell, text_size = size.small)
        table.cell(hud, 0, 21, "H12", bgcolor = hudBg, text_color = hudLb, text_size = size.small)
        table.cell(hud, 1, 21, h12Txt + (h12Gate ? "  ok" : "  block"), bgcolor = hudBg, text_color = h12Gate ? colBuy : colSell, text_size = size.small)
        table.cell(hud, 0, 22, "pp", bgcolor = hudBg, text_color = hudLb, text_size = size.small)
        table.cell(hud, 1, 22, (applyPP ? "" : "off / ") + (ppGate ? "yes" : "no"), bgcolor = hudBg, text_color = ppGate ? colBuy : colSell, text_size = size.small)
        table.cell(hud, 0, 23, "canEnter", bgcolor = hudBg, text_color = hudLb, text_size = size.small)
        table.cell(hud, 1, 23, canEnter ? "yes" : "no", bgcolor = hudBg, text_color = canEnter ? colBuy : colSell, text_size = size.small)

// ── shadow SHORT setups (long-only observe) ──────────────────────────────────
var int   sFills = 0
var int   sPos   = 0
var float sStp   = na
var float sTp1   = na
var bool  sTp1Hit = false
if stFlip
    sFills := 0
if sPos == -1
    bool sStop = high >= sStp
    bool sSlow = useTp1 and sTp1Hit and barstate.isconfirmed and close > sUp
    bool sFlip = exitStFlip and stBull
    if sStop or sSlow or sFlip
        sPos := 0
        sTp1Hit := false
    else
        if useTp1 and not sTp1Hit and not na(sTp1) and low <= sTp1
            sTp1Hit := true
        if useTp1 and sTp1Hit
            float sTr = trailStop(false)
            if not na(sTr) and sTr < sStp
                sStp := sTr
sTake = shortRaw and sFills < capReg and sPos == 0 and enableShort
if sTake
    sPos   := -1
    sStp   := stopPrice(false)
    sTp1   := close - tp1Mult * math.abs(close - sStp)
    sTp1Hit := false
    sFills := sFills + 1
    if longOnly and showShorts and showBadge
        label.new(bar_index, high, "▽ SHORT (observe)", yloc = yloc.abovebar, style = label.style_label_down, color = color.new(colHuntS, 10), textcolor = color.black, size = size.small)

if showAllSig and showBadge
    if longRaw and enableLong and not longSig
        label.new(bar_index, low, "▲ BUY", yloc = yloc.belowbar, style = label.style_label_up, color = color.new(colBuy, 30), textcolor = color.white, size = size.tiny)
    if shortRaw and enableShort and not shortSig and not (longOnly and sTake)
        label.new(bar_index, high, "▼ SELL", yloc = yloc.abovebar, style = label.style_label_down, color = color.new(colSell, 30), textcolor = color.white, size = size.tiny)

sellShow = shortSig or (longOnly and showShorts and sTake)
plotshape(longSig,  "Buy",  shape.triangleup,   location.belowbar, colBuy, size = size.small)
plotshape(sellShow, "Sell", shape.triangledown, location.abovebar, shortSig ? colSell : colHuntS, size = size.small)

bgcolor(shadeReg ? (stBullLive ? bgLongCol : bgShortCol) : na, title = "H1 Supertrend direction")

// ── alerts ─────────────────────────────────────────────────────────────────
alertcondition(longSig, "HA-Hunt M15/H1ST/M5: Long entry", "HA-Hunt M15/H1ST/M5 LONG {{ticker}} @ {{close}}")
alertcondition(shortSig, "HA-Hunt M15/H1ST/M5: Short entry", "HA-Hunt M15/H1ST/M5 SHORT {{ticker}} @ {{close}}")
alertcondition(longOnly and showShorts and sTake and sFills == 1, "HA-Hunt M15/H1ST/M5: Short setup (observe)", "HA-Hunt M15/H1ST/M5 short setup (observe) {{ticker}} @ {{close}}")
alertcondition(tp1Touch, "HA-Hunt M15/H1ST/M5: TP1", "HA-Hunt M15/H1ST/M5 TP1 {{ticker}} @ {{close}}")
alertcondition(exitStop, "HA-Hunt M15/H1ST/M5: Stop", "HA-Hunt M15/H1ST/M5 SL {{ticker}} @ {{close}}")
alertcondition(exitSlow, "HA-Hunt M15/H1ST/M5: Runner exit (slow band)", "HA-Hunt M15/H1ST/M5 runner exit slow-band {{ticker}} @ {{close}}")
alertcondition(doExit, "HA-Hunt M15/H1ST/M5: Exit", "HA-Hunt M15/H1ST/M5 EXIT {{ticker}} @ {{close}}")
alertcondition(stFlipLive and stBullLive, "HA-Hunt M15/H1ST/M5: H1 ST bull", "H1 Supertrend bull {{ticker}}")
alertcondition(stFlipLive and not stBullLive, "HA-Hunt M15/H1ST/M5: H1 ST bear", "H1 Supertrend bear {{ticker}}")

if longSig or shortSig or tp1Touch or doExit
    ev = longSig ? "entry_long" : shortSig ? "entry_short" : tp1Touch ? "tp1" : "exit"
    js = '{"strat":"ha_hunt_m15_st_m5","variant":"M15_H1ST_M5","event":"' + ev + '","symbol":"{{ticker}}","tf":"' + timeframe.period + '","price":' + str.tostring(close, format.mintick) + ',"stop":' + str.tostring(pos != 0 ? stpX : stpX[1], format.mintick) + ',"target":' + str.tostring(pos != 0 ? tgtX : tgtX[1], format.mintick) + ',"reason":"' + (doExit ? exitRsn : tp1Touch ? "tp1" : "signal") + '"}'
    alert(js, alert.freq_once_per_bar_close)
