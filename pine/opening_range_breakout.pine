//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// Opening-Range Breakout — session open impulse (GER40 London / US100 NY / any)
//
// Build the opening range from the first OR_MIN minutes after a session open,
// then take the first CLOSE beyond the range (long above the high, short below
// the low) inside an entry window. One trade per session.
//   SL  : opposite range edge | range mid | k × ATR(len) at entry
//   TP  : entry ± tpR × risk  (else exit at session_exit)
//   H4 filter (optional): long only if H4 close > H4 SMA(n), short only if <
//
// Research indicator only — NOT a strategy, no orders. Backtest (Capital M5,
// GER40+US100, 12 months, ~0.15R friction) showed NO net edge on the naive
// version; use this to watch / add a volatility-regime filter.
// ─────────────────────────────────────────────────────────────────────────────
indicator("Opening-Range Breakout", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ── session ──────────────────────────────────────────────────────────────────
openHHMM  = input.string("07:00", "Session open (exchange time HH:MM)", tooltip = "GER40 ~07:00, US100 ~13:30 — in the chart's exchange timezone.", group = "Session")
orMin     = input.int(15,  "Opening-range length (min)", minval = 5, step = 5, group = "Session")
entryWin  = input.int(90,  "Entry window after the range (min)", minval = 5, step = 5, group = "Session")
exitHrs   = input.float(4, "Session exit (hours after entry)", minval = 0.5, step = 0.5, group = "Session")
oneADay   = input.bool(true, "One trade per session (first side only)", group = "Session")

// ── risk ─────────────────────────────────────────────────────────────────────
slKind    = input.string("Range mid", "Stop", options = ["Opposite edge", "Range mid", "ATR"], group = "Risk")
atrLen    = input.int(14,  "ATR length", minval = 2, group = "Risk")
atrK      = input.float(1.0, "ATR ×  (when Stop = ATR)", minval = 0.1, step = 0.1, group = "Risk")
tpR       = input.float(2.0, "TP = R ×", minval = 0.5, step = 0.5, group = "Risk")

// ── H4 filter ────────────────────────────────────────────────────────────────
useH4     = input.bool(true, "H4 trend filter (with-trend only)", group = "H4 filter")
h4Sma     = input.int(20,  "H4 SMA period", minval = 5, group = "H4 filter")

// ── visuals ──────────────────────────────────────────────────────────────────
showRange = input.bool(true, "Opening-range box", group = "Visuals")
showRR    = input.bool(true, "Entry / SL / TP lines", group = "Visuals")
showBadge = input.bool(true, "Entry / exit badges", group = "Visuals")
showHud   = input.bool(true, "Corner HUD", group = "Visuals")
colLong   = input.color(#26A69A, "Long", group = "Visuals")
colShort  = input.color(#EF5350, "Short", group = "Visuals")
colRange  = input.color(#42A5F5, "Range", group = "Visuals")

// ── session-open detection ───────────────────────────────────────────────────
oh = int(str.tonumber(str.substring(openHHMM, 0, 2)))
om = int(str.tonumber(str.substring(openHHMM, 3, 5)))
tfMin = timeframe.in_seconds(timeframe.period) / 60
inNewSession = (hour == oh and minute == om) or (hour == oh and minute >= om and minute < om + tfMin)
isNew = inNewSession and not (inNewSession[1])

atrV = ta.atr(atrLen)

// H4 bias — confirmed close vs SMA (no lookahead)
h4Bias = request.security(syminfo.tickerid, "240", close[1] > ta.sma(close, h4Sma)[1] ? 1 : -1, lookahead = barmerge.lookahead_off)

var float orHi   = na
var float orLo   = na
var int   orEnd  = na          // ms
var int   winEnd = na
var bool  sessDone = false
var int   pos    = 0           // 0 flat, 1 long, -1 short
var float entPx  = na
var float stpX   = na
var float tpX    = na
var int   tExit  = na
var box   bxR    = na
var line  lnE    = na
var line  lnS    = na
var line  lnT    = na

if isNew
    orHi := high
    orLo := low
    orEnd := time + orMin * 60 * 1000
    winEnd := orEnd + entryWin * 60 * 1000
    sessDone := false
    // detach previous session's box/lines
    bxR := na, lnE := na, lnS := na, lnT := na
else if not na(orEnd) and time < orEnd
    orHi := math.max(orHi, high)
    orLo := math.min(orLo, low)

rangeReady = not na(orEnd) and time >= orEnd
mid = na(orHi) ? na : (orHi + orLo) / 2

if showRange and rangeReady and na(bxR) and not na(orHi)
    bxR := box.new(bar_index, orHi, bar_index + 1, orLo, border_color = color.new(colRange, 20), bgcolor = color.new(colRange, 92))
if showRange and not na(bxR) and pos == 0 and not sessDone
    box.set_right(bxR, bar_index + 1)

// ── entry ────────────────────────────────────────────────────────────────────
canEnter = rangeReady and pos == 0 and not sessDone and time <= winEnd and barstate.isconfirmed
brkUp = canEnter and close > orHi
brkDn = canEnter and close < orLo
sideRaw = brkUp ? 1 : (brkDn ? -1 : 0)
sideOk  = sideRaw != 0 and (not useH4 or na(h4Bias) or h4Bias == sideRaw)

if sideOk
    pos   := sideRaw
    entPx := close
    stpX  := slKind == "Opposite edge" ? (pos == 1 ? orLo : orHi) : slKind == "Range mid" ? mid : (pos == 1 ? close - atrK * atrV : close + atrK * atrV)
    risk  = math.abs(entPx - stpX)
    tpX   := pos == 1 ? entPx + tpR * risk : entPx - tpR * risk
    tExit := time + int(exitHrs * 3600 * 1000)
    if oneADay
        sessDone := true
    if showRR
        lnE := line.new(bar_index, entPx, bar_index + 1, entPx, color = color.new(colRange, 0), style = line.style_dotted)
        lnS := line.new(bar_index, stpX, bar_index + 1, stpX, color = color.new(colShort, 0), width = 2)
        lnT := line.new(bar_index, tpX,  bar_index + 1, tpX,  color = color.new(colLong, 0), width = 2)
    if showBadge
        label.new(bar_index, pos == 1 ? low : high, (pos == 1 ? "▲ ORB LONG" : "▼ ORB SHORT"), yloc = pos == 1 ? yloc.belowbar : yloc.abovebar, style = pos == 1 ? label.style_label_up : label.style_label_down, color = color.new(pos == 1 ? colLong : colShort, 0), textcolor = color.white, size = size.small)

// ── manage ───────────────────────────────────────────────────────────────────
if pos != 0
    if showRR and not na(lnE)
        line.set_x2(lnE, bar_index + 1), line.set_x2(lnS, bar_index + 1), line.set_x2(lnT, bar_index + 1)
    hitStop = pos == 1 ? low <= stpX : high >= stpX
    hitTp   = pos == 1 ? high >= tpX : low <= tpX
    timeOut = time >= tExit
    if hitStop or hitTp or timeOut
        px = hitStop ? stpX : hitTp ? tpX : close
        r  = (px - entPx) * pos / math.abs(entPx - stpX)
        if showBadge
            label.new(bar_index, pos == 1 ? high : low, (hitStop ? "SL " : hitTp ? "TP " : "TIME ") + str.tostring(r, "#.##") + "R", yloc = pos == 1 ? yloc.abovebar : yloc.belowbar, style = pos == 1 ? label.style_label_down : label.style_label_up, color = color.new(r > 0 ? colLong : colShort, 10), textcolor = color.white, size = size.small)
        alert('{"strat":"orb","event":"exit","symbol":"{{ticker}}","price":' + str.tostring(close) + ',"r":' + str.tostring(r, "#.###") + ',"reason":"' + (hitStop ? "stop" : hitTp ? "tp" : "time") + '"}', alert.freq_once_per_bar_close)
        pos := 0
        lnE := na, lnS := na, lnT := na

// ── HUD ──────────────────────────────────────────────────────────────────────
var table hud = na
if barstate.islast and showHud
    if na(hud)
        hud := table.new(position.bottom_right, 2, 6, bgcolor = #1E222D, frame_width = 1, frame_color = #787B86, border_width = 1, border_color = #787B86)
    sTxt = pos == 0 ? "FLAT" : pos == 1 ? "LONG" : "SHORT"
    table.cell(hud, 0, 0, "ORB", text_color = color.white, text_size = size.normal), table.cell(hud, 1, 0, openHHMM + " / " + str.tostring(orMin) + "m", text_color = #B2B5BE, text_size = size.normal)
    table.cell(hud, 0, 1, "Range", text_color = #B2B5BE, text_size = size.small), table.cell(hud, 1, 1, na(orHi) ? "—" : str.tostring(orLo, format.mintick) + " / " + str.tostring(orHi, format.mintick), text_color = color.white, text_size = size.small)
    table.cell(hud, 0, 2, "Side", text_color = #B2B5BE, text_size = size.small), table.cell(hud, 1, 2, sTxt, text_color = pos == 0 ? color.gray : pos == 1 ? colLong : colShort, text_size = size.small)
    table.cell(hud, 0, 3, "Stop", text_color = #B2B5BE, text_size = size.small), table.cell(hud, 1, 3, pos == 0 ? "—" : str.tostring(stpX, format.mintick), text_color = colShort, text_size = size.small)
    table.cell(hud, 0, 4, "TP", text_color = #B2B5BE, text_size = size.small), table.cell(hud, 1, 4, pos == 0 ? "—" : str.tostring(tpX, format.mintick), text_color = colLong, text_size = size.small)
    table.cell(hud, 0, 5, "H4 bias", text_color = #B2B5BE, text_size = size.small), table.cell(hud, 1, 5, na(h4Bias) ? "—" : h4Bias == 1 ? "bull" : "bear", text_color = h4Bias == 1 ? colLong : colShort, text_size = size.small)

plotshape(sideOk and not showBadge, "entry", shape.triangleup, location.belowbar, colLong, size = size.tiny)
alertcondition(brkUp, "ORB long break", "ORB long break {{ticker}} @ {{close}}")
alertcondition(brkDn, "ORB short break", "ORB short break {{ticker}} @ {{close}}")
