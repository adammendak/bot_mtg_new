//
// Modified copy (same licence, non-commercial use): crossover signals are drawn as real ARROWS, bigger,
// above/below the candle, with size / colour / distance inputs ("Arrows" group); the original tiny emoji
// labels are optional ("Original labels"). Retest marks have a size input. Alerts added. The background
// shading (band between the two Kalman lines, level boxes) can be switched off in the "Background" group
// (both off by default). A table at the end of the script shows a stop-and-reverse simulation of the crossover
// signals (trades, win rate, avg and total %, profit factor, long/short split, buy & hold). The Kalman
// calculation and the trend logic are unchanged.

//@version=5
indicator("Kalman Trend Levels + Arrows", overlay = true, max_labels_count = 500, max_boxes_count = 500)

// ＩＮＰＵＴＳ ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{
int short_len     = input.int(50)
int long_len      = input.int(150)
bool retest_sig   = input.bool(false, "Retest Signals")
bool candle_color = input.bool(true, "Candle Color")

color upper_col = input.color(#13bd6e, "up", inline = "colors")
color lower_col = input.color(#af0d4b, "dn", inline = "colors")

// arrows (new)
bool   show_arrows  = input.bool(true, "Show arrows", group = "Arrows")
string arrow_size_s = input.string("Large", "Arrow size", options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = "Arrows")
string arrow_place  = input.string("Candle", "Arrow position", options = ["Candle", "Kalman line"], tooltip = "Candle = BUY arrow below the low, SELL arrow above the high. Kalman line = on the short Kalman line.", group = "Arrows")
float  arrow_off    = input.float(0.6, "Distance from candle (x ATR14)", minval = 0.0, step = 0.1, group = "Arrows")
color  arrow_up_col = input.color(#00e676, "Buy arrow", inline = "acol", group = "Arrows")
color  arrow_dn_col = input.color(#ff1744, "Sell arrow", inline = "acol", group = "Arrows")
bool   show_price   = input.bool(true, "Show price under/over the arrow", group = "Arrows")
float  price_gap    = input.float(1.0, "Price text gap (x ATR14)", minval = 0.0, step = 0.1, group = "Arrows")
string price_size_s = input.string("Normal", "Price text size", options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = "Arrows")
bool   orig_labels  = input.bool(false, "Original labels (small emoji arrows)", group = "Arrows")
string mark_size_s  = input.string("Normal", "Retest mark size", options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = "Arrows")

// background colour (new) - both off by default, so nothing is shaded behind the candles
bool show_fill  = input.bool(false, "Shade between the Kalman lines", tooltip = "The translucent band between the short and the long Kalman line (red in a downtrend, green in an uptrend).", group = "Background")
bool show_boxes = input.bool(false, "Level boxes behind the signal candle", tooltip = "The translucent box that opens on a crossover and stays open while the trend lasts. Retest marks still use these levels when the boxes are hidden.", group = "Background")

// strategy table (new)
bool   show_table = input.bool(true, "Show strategy table", group = "Table")
string table_pos  = input.string("Top Right", "Table position", options = ["Top Left", "Top Right", "Middle Right", "Bottom Left", "Bottom Right"], group = "Table")
float  cost_pct   = input.float(0.01, "Cost per side (% of price)", minval = 0.0, step = 0.01, tooltip = "Spread + slippage charged on entry and again on exit of every simulated trade. Research used 0.01% for indices and 0.04% for BTC.", group = "Table")

// }

f_size(s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Large"  => size.large
        "Huge"   => size.huge
        => size.normal

f_pos(s) =>
    switch s
        "Top Left"     => position.top_left
        "Middle Right" => position.middle_right
        "Bottom Left"  => position.bottom_left
        "Bottom Right" => position.bottom_right
        => position.top_right

f_sgn(v) =>
    v > 0 ? "+" : ""

string arrow_size = f_size(arrow_size_s)
string price_size = f_size(price_size_s)
string mark_size  = f_size(mark_size_s)


// ＣＡＬＣＵＬＡＴＩＯＮＳ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{
float atr = ta.atr(200) *0.5
float atr14 = ta.atr(14)

var lower_box = box(na)
var upper_box = box(na)


// Kalman filter function
kalman_filter(src, length, R = 0.01, Q = 0.1) =>
    // Initialize variables
    var float estimate = na
    var float error_est = 1.0
    var float error_meas = R * (length)
    var float kalman_gain = 0.0
    var float prediction = na

    // Initialize the estimate with the first value of the source
    if na(estimate)
        estimate := src[1]

    // Prediction step
    prediction := estimate

    // Update Kalman gain
    kalman_gain := error_est / (error_est + error_meas)

    // Update estimate with measurement correction
    estimate := prediction + kalman_gain * (src - prediction)

    // Update error estimates
    error_est := (1 - kalman_gain) * error_est  + Q / (length) // Adjust process noise based on length

    estimate

float short_kalman = kalman_filter(close, short_len)
float long_kalman = kalman_filter(close, long_len)

bool trend_up = short_kalman > long_kalman

color trend_col  = trend_up ? upper_col : lower_col
color trend_col1 = short_kalman > short_kalman[2] ? upper_col : lower_col
color candle_col = candle_color ? (trend_up and short_kalman > short_kalman[2] ? upper_col : not trend_up and short_kalman < short_kalman[2] ? lower_col : color.gray) : na

bool buy_sig  = trend_up and not trend_up[1]
bool sell_sig = trend_up[1] and not trend_up

// }


// ＰＬＯＴ ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{
if buy_sig
    if orig_labels
        label.new(bar_index, short_kalman, "🡹\n" + str.tostring(math.round(close,1)), color = color(na), textcolor = upper_col, style = label.style_label_up, size = size.normal)
    if show_arrows
        float y = (arrow_place == "Candle" ? low : short_kalman) - atr14 * arrow_off
        label.new(bar_index, y, "", yloc = yloc.price, style = label.style_arrowup, color = arrow_up_col, size = arrow_size)
        if show_price
            label.new(bar_index, y - atr14 * price_gap, str.tostring(math.round(close, 1)), yloc = yloc.price,
                 style = label.style_label_up, color = color(na), textcolor = arrow_up_col, size = price_size)
    lower_box := box.new(bar_index, low+atr, bar_index, low, border_color = na, bgcolor = show_boxes ? color.new(upper_col, 60) : color(na))

if not ta.change(trend_up)
    lower_box.set_right(bar_index)

if sell_sig
    if orig_labels
        label.new(bar_index, short_kalman, str.tostring(math.round(close,1))+"\n🢃", color = color(na), textcolor = lower_col, style = label.style_label_down, size = size.normal)
    if show_arrows
        float y = (arrow_place == "Candle" ? high : short_kalman) + atr14 * arrow_off
        label.new(bar_index, y, "", yloc = yloc.price, style = label.style_arrowdown, color = arrow_dn_col, size = arrow_size)
        if show_price
            label.new(bar_index, y + atr14 * price_gap, str.tostring(math.round(close, 1)), yloc = yloc.price,
                 style = label.style_label_down, color = color(na), textcolor = arrow_dn_col, size = price_size)
    upper_box := box.new(bar_index, high, bar_index, high-atr, border_color = na, bgcolor = show_boxes ? color.new(lower_col, 60) : color(na))

if not ta.change(trend_up)
    upper_box.set_right(bar_index)

if retest_sig
    if not na(upper_box) and high < upper_box.get_bottom() and high[1]>= upper_box.get_bottom() //or high < lower_box.get_bottom() and high[1]>= lower_box.get_bottom()
        label.new(bar_index-1, high[1], "x", color = color(na), textcolor = lower_col, style = label.style_label_down, size = mark_size)

    if not na(lower_box) and low > lower_box.get_top() and low[1]<= lower_box.get_top()
        label.new(bar_index-1, low[1], "+", color = color(na), textcolor = upper_col, style = label.style_label_up, size = mark_size)

p1 = plot(short_kalman, "Short Kalman", color = trend_col1)
p2 = plot(long_kalman, "Long Kalman", linewidth = 2, color = trend_col)

color fill_col = show_fill ? color.new(trend_col, 80) : color(na)
fill(p1, p2, short_kalman, long_kalman, na, fill_col)

plotcandle(open, high, low, close, title='Title', color = candle_col, wickcolor=candle_col, bordercolor = candle_col)

alertcondition(buy_sig,  "Kalman BUY",  "Kalman Trend: short crossed ABOVE long - {{ticker}} {{interval}}")
alertcondition(sell_sig, "Kalman SELL", "Kalman Trend: short crossed BELOW long - {{ticker}} {{interval}}")
// }


// ＳＴＲＡＴＥＧＹ ＴＡＢＬＥ (new) ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{
// Stop-and-reverse simulation of the crossover signals: always in the market, long while the short Kalman is
// above the long one, short otherwise. A signal is known at the close of the crossover candle, the trade is
// filled at the OPEN of the next candle. Returns are % of price, one unit of notional, summed (no compounding);
// the cost per side is charged on entry and again on exit. Retest marks are not traded. It runs over the bars
// loaded on the chart, after a warm-up of 2 x the long length.
bool sim_on = bar_index > 2 * long_len
var int   s_pos   = 0
var float s_entry = na
var float s_start = na
var int   s_n     = 0
var int   s_win   = 0
var int   s_nl    = 0
var int   s_ns    = 0
var float s_sum   = 0.0
var float s_suml  = 0.0
var float s_sums  = 0.0
var float s_gw    = 0.0
var float s_gl    = 0.0

if sim_on and na(s_start)
    s_start := open

if sim_on and (buy_sig[1] or sell_sig[1])
    if s_pos != 0
        float ret = (s_pos * (open / s_entry - 1.0) - 2.0 * cost_pct / 100.0) * 100.0
        s_n += 1
        s_sum += ret
        if s_pos == 1
            s_nl += 1
            s_suml += ret
        else
            s_ns += 1
            s_sums += ret
        if ret > 0
            s_win += 1
            s_gw += ret
        else
            s_gl += -ret
    s_pos := buy_sig[1] ? 1 : -1
    s_entry := open

if show_table and barstate.islast
    var table tb = table.new(f_pos(table_pos), 2, 12, bgcolor = color.new(color.black, 25), border_width = 1, border_color = color.gray)
    float open_ret = s_pos != 0 and not na(s_entry) ? (s_pos * (close / s_entry - 1.0) - cost_pct / 100.0) * 100.0 : na
    string t_win = s_n > 0 ? str.tostring(100.0 * s_win / s_n, "0") + "%" : "-"
    string t_avg = s_n > 0 ? f_sgn(s_sum) + str.tostring(s_sum / s_n, "0.00") + "%" : "-"
    string t_tot = f_sgn(s_sum) + str.tostring(s_sum, "0.0") + "%"
    string t_pf  = s_gl > 0 ? str.tostring(s_gw / s_gl, "0.00") : "-"
    string t_l   = str.tostring(s_nl) + " / " + (s_nl > 0 ? f_sgn(s_suml) + str.tostring(s_suml / s_nl, "0.00") + "%" : "-")
    string t_s   = str.tostring(s_ns) + " / " + (s_ns > 0 ? f_sgn(s_sums) + str.tostring(s_sums / s_ns, "0.00") + "%" : "-")
    string t_bh  = na(s_start) ? "-" : f_sgn(close - s_start) + str.tostring((close / s_start - 1.0) * 100.0, "0.0") + "%"
    string t_now = s_pos == 0 ? "-" : (s_pos == 1 ? "LONG " : "SHORT ") + f_sgn(open_ret) + str.tostring(open_ret, "0.00") + "%"
    table.cell(tb, 0, 0, "Kalman stop & reverse", text_color = color.white, bgcolor = color.new(#2962FF, 0), text_size = size.small)
    table.cell(tb, 1, 0, str.tostring(short_len) + " / " + str.tostring(long_len), text_color = color.white, bgcolor = color.new(#2962FF, 0), text_size = size.small)
    table.cell(tb, 0, 1, "Rules", text_color = color.silver, text_size = size.small)
    table.cell(tb, 1, 1, "always in market, flips on crossover", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 2, "Fill / cost", text_color = color.silver, text_size = size.small)
    table.cell(tb, 1, 2, "next open, " + str.tostring(cost_pct, "0.00") + "% per side", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 3, "Trades", text_color = color.silver, text_size = size.small)
    table.cell(tb, 1, 3, str.tostring(s_n), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 4, "Win rate", text_color = color.silver, text_size = size.small)
    table.cell(tb, 1, 4, t_win, text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 5, "Avg / trade", text_color = color.silver, text_size = size.small)
    table.cell(tb, 1, 5, t_avg, text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 6, "Total (sum of %)", text_color = color.silver, text_size = size.small)
    table.cell(tb, 1, 6, t_tot, text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 7, "Profit factor", text_color = color.silver, text_size = size.small)
    table.cell(tb, 1, 7, t_pf, text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 8, "Long n / avg", text_color = color.silver, text_size = size.small)
    table.cell(tb, 1, 8, t_l, text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 9, "Short n / avg", text_color = color.silver, text_size = size.small)
    table.cell(tb, 1, 9, t_s, text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 10, "Buy & hold", text_color = color.silver, text_size = size.small)
    table.cell(tb, 1, 10, t_bh, text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 11, "Now", text_color = color.silver, text_size = size.small)
    table.cell(tb, 1, 11, t_now, text_color = color.white, text_size = size.small)
// }
