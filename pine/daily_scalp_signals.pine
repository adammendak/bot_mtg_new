//@version=5
// Daily Scalp Signals — 1 entry per day, small fixed take-profit, failsafe instead of a stop.
// Research indicator (no orders). Companion of docs/DAILY-SCALP-STRATEGY.md and tools/daily_scalp_bt.py.
//
//  * Signals are evaluated on CLOSED bars of the chart timeframe (use H1). The backtest enters at the next open.
//  * At most one entry per UTC day, optionally only inside an entry window (US session for NQ / SP500).
//  * Exit: TP = tpPct % of price. Failsafe stop = fsMult x TP distance (0 = off). Flat at holdDays / eodHour UTC.
//  * Same-bar TP + failsafe -> failsafe is counted first (conservative, same as the backtest).
//  * Alerts (alert() with JSON, "Once per bar close") use the bot's webhook format:
//      entry  -> "event":"entry"  (+ "sl" = failsafe level, "tp" = take-profit level)
//      TP hit -> "event":"tp"
//      failsafe / time exit -> "event":"invalid"
//    Set the webhook secret and strat name in the inputs. Create ONE alert: condition "Any alert() function call".
indicator("Daily Scalp Signals (1/day, TP + failsafe)", shorttitle="DScalp", overlay=true, max_labels_count=300)

// ------------------------------------------------------------------ inputs
sigType   = input.string("PIVOT_BOUNCE", "Signal", options=["PIVOT_BOUNCE", "RSI_CROSS", "STOCH_CROSS", "WT_CROSS", "PIVOT_BREAK"], group="Signal")
tpPct     = input.float(0.30, "TP distance (% of price)", minval=0.02, step=0.01, group="Exit")
fsMult    = input.float(8.0, "Failsafe stop = x TP distance (0 = off)", minval=0.0, step=0.5, group="Exit")
holdDays  = input.int(3, "Max hold (calendar days; 0 = flat the same day)", minval=0, maxval=10, group="Exit")
eodHour   = input.int(21, "Force-flat hour (UTC)", minval=0, maxval=23, group="Exit")
useWin    = input.bool(true, "Enter only inside the window", group="Window")
winSess   = input.session("1330-1930", "Entry window (UTC)", group="Window")
costPct   = input.float(0.012, "Round-trip cost (% of price) for the R tally", minval=0.0, step=0.001, group="Stats")
secret    = input.string("<SEKRET>", "Webhook secret (alert JSON)", group="Alerts")
stratName = input.string("scalp-nq", "strat in the alert JSON", group="Alerts")

// ------------------------------------------------------------------ indicators
rsiV = ta.rsi(close, 14)
k    = ta.sma(ta.stoch(close, high, low, 14), 3)
d    = ta.sma(k, 3)

// WaveTrend (Market Cipher B core): channel 9, average 12, signal SMA 3
ap  = hlc3
esa = ta.ema(ap, 9)
dev = ta.ema(math.abs(ap - esa), 9)
ci  = (ap - esa) / (0.015 * dev)
wt1 = ta.ema(ci, 12)
wt2 = ta.sma(wt1, 3)

// Previous UTC day classic pivots
[pH, pL, pC] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], lookahead = barmerge.lookahead_on)
piv = (pH + pL + pC) / 3
r1  = 2 * piv - pL
s1  = 2 * piv - pH

rsiUp = ta.crossover(rsiV, 30)
rsiDn = ta.crossunder(rsiV, 70)
stUp  = ta.crossover(k, d) and k < 25
stDn  = ta.crossunder(k, d) and k > 75
wtUp  = ta.crossover(wt1, wt2) and wt1 < -45
wtDn  = ta.crossunder(wt1, wt2) and wt1 > 45
pbUp  = ta.crossover(close, piv)
pbDn  = ta.crossunder(close, piv)
bounceUp = low <= s1 and close > s1
bounceDn = high >= r1 and close < r1

longSig  = sigType == "RSI_CROSS" ? rsiUp : sigType == "STOCH_CROSS" ? stUp : sigType == "WT_CROSS" ? wtUp : sigType == "PIVOT_BREAK" ? pbUp : bounceUp
shortSig = sigType == "RSI_CROSS" ? rsiDn : sigType == "STOCH_CROSS" ? stDn : sigType == "WT_CROSS" ? wtDn : sigType == "PIVOT_BREAK" ? pbDn : bounceDn

// ------------------------------------------------------------------ state
var int   dirn      = 0
var float entryPx   = na
var float tpPx      = na
var float fsPx      = na
var int   entryBar  = na
var int   exitT     = na
var int   tradedDay = 0
var int   nTp       = 0
var int   nFs       = 0
var int   nTime     = 0
var float sumR      = 0.0

dayKey = year(time, "UTC") * 10000 + month(time, "UTC") * 100 + dayofmonth(time, "UTC")
inWin  = not useWin or not na(time(timeframe.period, winSess, "UTC"))
dFrac  = tpPct / 100.0

fmt(x) => str.tostring(x, format.mintick)

// ------------------------------------------------------------------ exits first (a trade opened on a previous bar)
if barstate.isconfirmed and dirn != 0 and bar_index > entryBar
    hitFs  = not na(fsPx) and (dirn == 1 ? low <= fsPx : high >= fsPx)
    hitTp  = dirn == 1 ? high >= tpPx : low <= tpPx
    timeUp = time_close >= exitT
    if hitFs or hitTp or timeUp
        float r = 0.0
        string kind = ""
        if hitFs
            r := -fsMult
            kind := "FS"
            nFs += 1
        else if hitTp
            r := 1.0
            kind := "TP"
            nTp += 1
        else
            r := (close - entryPx) * dirn / (entryPx * dFrac)
            kind := "TIME"
            nTime += 1
        sumR += r - costPct / tpPct
        label.new(bar_index, dirn == 1 ? high : low, kind + " " + str.tostring(r, "#.##") + "R", color = kind == "TP" ? color.green : color.red, textcolor = color.white, style = dirn == 1 ? label.style_label_down : label.style_label_up, size = size.small)
        string ev = kind == "TP" ? "tp" : "invalid"
        alert("{\"secret\":\"" + secret + "\",\"strat\":\"" + stratName + "\",\"event\":\"" + ev + "\",\"side\":\"" + (dirn == 1 ? "BUY" : "SELL") + "\",\"sym\":\"" + syminfo.ticker + "\",\"tf\":\"" + timeframe.period + "\",\"price\":\"" + fmt(close) + "\",\"t\":\"" + str.format_time(time, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + "\"}", alert.freq_once_per_bar_close)
        dirn := 0

// ------------------------------------------------------------------ entry (one per UTC day)
canEnter = barstate.isconfirmed and dirn == 0 and inWin and tradedDay != dayKey
if canEnter and (longSig != shortSig)
    dirn := longSig ? 1 : -1
    entryPx := close
    tpPx := entryPx * (1 + dirn * dFrac)
    fsPx := fsMult > 0 ? entryPx * (1 - dirn * dFrac * fsMult) : na
    entryBar := bar_index
    exitT := timestamp("UTC", year(time, "UTC"), month(time, "UTC"), dayofmonth(time, "UTC") + holdDays, eodHour, 0, 0)
    tradedDay := dayKey
    label.new(bar_index, dirn == 1 ? low : high, (dirn == 1 ? "BUY " : "SELL ") + fmt(entryPx), color = dirn == 1 ? color.teal : color.maroon, textcolor = color.white, style = dirn == 1 ? label.style_label_up : label.style_label_down, size = size.small)
    alert("{\"secret\":\"" + secret + "\",\"strat\":\"" + stratName + "\",\"event\":\"entry\",\"side\":\"" + (dirn == 1 ? "BUY" : "SELL") + "\",\"sym\":\"" + syminfo.ticker + "\",\"tf\":\"" + timeframe.period + "\",\"price\":\"" + fmt(close) + "\",\"sl\":\"" + (na(fsPx) ? "" : fmt(fsPx)) + "\",\"tp\":\"" + fmt(tpPx) + "\",\"t\":\"" + str.format_time(time, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + "\"}", alert.freq_once_per_bar_close)

// ------------------------------------------------------------------ plots
plot(dirn != 0 ? entryPx : na, "Entry", color = color.new(color.gray, 0), style = plot.style_linebr)
plot(dirn != 0 ? tpPx : na, "TP", color = color.new(color.green, 0), style = plot.style_linebr, linewidth = 2)
plot(dirn != 0 ? fsPx : na, "Failsafe", color = color.new(color.red, 0), style = plot.style_linebr, linewidth = 2)
plot(piv, "Pivot P", color = color.new(color.gray, 60), style = plot.style_stepline)
plot(r1, "R1", color = color.new(color.red, 60), style = plot.style_stepline)
plot(s1, "S1", color = color.new(color.green, 60), style = plot.style_stepline)

// ------------------------------------------------------------------ HUD
var table hud = table.new(position.top_right, 2, 6, bgcolor = color.new(color.black, 20), border_width = 1)
if barstate.islast
    int n = nTp + nFs + nTime
    table.cell(hud, 0, 0, "Signal", text_color = color.white)
    table.cell(hud, 1, 0, sigType, text_color = color.white)
    table.cell(hud, 0, 1, "Trades", text_color = color.white)
    table.cell(hud, 1, 1, str.tostring(n), text_color = color.white)
    table.cell(hud, 0, 2, "TP / failsafe / time", text_color = color.white)
    table.cell(hud, 1, 2, str.tostring(nTp) + " / " + str.tostring(nFs) + " / " + str.tostring(nTime), text_color = color.white)
    table.cell(hud, 0, 3, "Win rate", text_color = color.white)
    table.cell(hud, 1, 3, n > 0 ? str.tostring(100.0 * nTp / n, "#.0") + "%" : "-", text_color = color.white)
    table.cell(hud, 0, 4, "Net R (after cost)", text_color = color.white)
    table.cell(hud, 1, 4, str.tostring(sumR, "#.00"), text_color = sumR >= 0 ? color.lime : color.red)
    table.cell(hud, 0, 5, "R / trade", text_color = color.white)
    table.cell(hud, 1, 5, n > 0 ? str.tostring(sumR / n, "#.000") : "-", text_color = color.white)
