//@version=5
indicator("MMS Mean Reversion (MastermindZX)", overlay=true, max_labels_count=200, max_bars_back=500)

// Bot-side sibling: HtsVariant.MMS / MmsEngine (closed-bar only, no lookahead).
// Site: https://mastermindzx.pl/  — BTCUSDT backtests there are monthly-optimised.

atrPeriod = input.int(20, "ATR / MA period", minval=2, group="Envelope")
atrMult   = input.float(2.0, "ATR multiplier", minval=0.1, step=0.1, group="Envelope")
mode      = input.string("TMA_ATR", "Envelope type", options=["TMA_ATR", "BB_ATR"], group="Envelope")
slPct     = input.float(2.0, "Stop loss % of price (site default ~2%)", minval=0.1, step=0.1, group="Risk")
tfNote    = input.string("M15", "Entry TF note (bot default M15; also M10 / M20 / M30 / H1)", group="Timeframe")
reactWin  = input.int(8, "Reaction window (bars after touch)", minval=1, maxval=32, group="Entry")
addOn     = input.bool(false, "Add-on ×1 after one confirming candle (bot default off)", group="Optional")
stochFlt  = input.bool(false, "H1 Stoch(14,3,3) extreme filter for adds (bot default off)", group="Optional")
stochLen  = input.int(14, "Stoch length", minval=2, group="Optional")
stochK    = input.int(3, "Stoch %K smooth", minval=1, group="Optional")
stochD    = input.int(3, "Stoch %D smooth", minval=1, group="Optional")

tma    = ta.sma(ta.sma(close, atrPeriod), atrPeriod)
smaMid = ta.sma(close, atrPeriod)
centre = mode == "TMA_ATR" ? tma : smaMid
atrVal = ta.atr(atrPeriod)
upper  = centre + atrMult * atrVal
lower  = centre - atrMult * atrVal

plot(centre, "Centre", color=color.new(color.gray, 0), linewidth=1)
uPlot  = plot(upper, "Upper", color=color.new(color.red, 0))
lPlot  = plot(lower, "Lower", color=color.new(color.teal, 0))
fill(uPlot, lPlot, color=color.new(color.blue, 92), title="ATR envelope")

touchUpper = not na(upper) and high >= upper
touchLower = not na(lower) and low  <= lower

// First reactive candle after a band touch on a *previous* closed bar.
// Wait for the touch bar to close, then the first opposite-colour body.
upperSetup = false
lowerSetup = false
if not na(upper)
    for i = 1 to reactWin
        if high[i] >= upper[i]
            upperSetup := true
            break
        if close[i] < open[i]
            break
if not na(lower)
    for i = 1 to reactWin
        if low[i] <= lower[i]
            lowerSetup := true
            break
        if close[i] > open[i]
            break

reactDown = close < open
reactUp   = close > open
shortEntry = barstate.isconfirmed and upperSetup and reactDown
longEntry  = barstate.isconfirmed and lowerSetup and reactUp

plotshape(touchUpper and barstate.isconfirmed, title="Upper band touch", style=shape.triangledown,
     location=location.abovebar, color=color.new(color.red, 30), size=size.tiny)
plotshape(touchLower and barstate.isconfirmed, title="Lower band touch", style=shape.triangleup,
     location=location.belowbar, color=color.new(color.teal, 30), size=size.tiny)
plotshape(shortEntry, title="SHORT reaction", style=shape.arrowdown,
     location=location.abovebar, color=color.red, size=size.small, text="S")
plotshape(longEntry, title="LONG reaction", style=shape.arrowup,
     location=location.belowbar, color=color.lime, size=size.small, text="L")

slLong  = close * (1.0 - slPct * 0.01)
slShort = close * (1.0 + slPct * 0.01)
plot(longEntry  ? slLong  : na, "Long SL",  color=color.maroon, style=plot.style_circles, linewidth=2)
plot(shortEntry ? slShort : na, "Short SL", color=color.maroon, style=plot.style_circles, linewidth=2)

// Optional H1 stoch extreme (adds only — visual, matches bot flags default off).
h1k = request.security(syminfo.tickerid, "60", ta.sma(ta.stoch(close, high, low, stochLen), stochK), lookahead=barmerge.lookahead_off)
stochOkLong  = not stochFlt or h1k <= 20
stochOkShort = not stochFlt or h1k >= 80
addLong  = addOn and longEntry  and stochOkLong  and close > close[1]
addShort = addOn and shortEntry and stochOkShort and close < close[1]
plotshape(addLong,  title="Add LONG",  style=shape.circle, location=location.belowbar, color=color.aqua, size=size.tiny)
plotshape(addShort, title="Add SHORT", style=shape.circle, location=location.abovebar, color=color.orange, size=size.tiny)

alertcondition(longEntry,  title="MMS LONG",  message="MMS LONG reaction — lower band touch + first up candle")
alertcondition(shortEntry, title="MMS SHORT", message="MMS SHORT reaction — upper band touch + first down candle")

var table info = table.new(position.top_right, 1, 3, bgcolor=color.new(color.black, 70))
if barstate.islast
    table.cell(info, 0, 0, "MMS  " + tfNote + "  " + mode, text_color=color.white, text_size=size.small)
    table.cell(info, 0, 1, "ATR " + str.tostring(atrPeriod) + " × " + str.tostring(atrMult) + "   SL " + str.tostring(slPct) + "%", text_color=color.silver, text_size=size.tiny)
    table.cell(info, 0, 2, "add-on " + (addOn ? "ON" : "off") + "   stoch " + (stochFlt ? "ON" : "off"), text_color=color.gray, text_size=size.tiny)
