<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      E-7: TOTP 2FA for admin sign-in. totp_pending_secret holds a secret during
      enrolment; on a verified code it moves to totp_secret and totp_enabled
      flips true. Backup codes are one-time SHA-256 hashes.
    -->
    <changeSet id="017-user-totp" author="amendak">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="app_users" columnName="totp_enabled"/></not>
        </preConditions>
        <addColumn tableName="app_users">
            <column name="totp_secret" type="VARCHAR(64)"/>
            <column name="totp_pending_secret" type="VARCHAR(64)"/>
            <column name="totp_enabled" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="017-user-backup-codes" author="amendak">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="user_backup_codes"/></not>
        </preConditions>
        <createTable tableName="user_backup_codes">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="code_hash" type="VARCHAR(128)"><constraints nullable="false"/></column>
            <column name="used_at" type="TIMESTAMP"/>
        </createTable>
        <createIndex tableName="user_backup_codes" indexName="idx_backup_codes_user">
            <column name="user_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
