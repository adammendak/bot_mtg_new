<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      SDD-M15 / SDD-SWING are retired. Their feature flags are gone from the code
      (schedulers back to plain SCAN_ENABLED / SWING_ENABLED env vars, default
      off). Drop any stale override rows so the panel is HTS-only.
    -->
    <changeSet id="018-drop-sdd-feature-flags" author="amendak">
        <delete tableName="feature_flags">
            <where>name in ('sdd.scan','sdd.execution','swing.scan','swing.execution')</where>
        </delete>
    </changeSet>
</databaseChangeLog>
